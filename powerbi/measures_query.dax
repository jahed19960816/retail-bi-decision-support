// Paste into Power BI Desktop > DAX query view, click Run, then 'Update model with changes'.
// Adds all measures from measures.dax to the _Measures table in one go (generated from measures.dax).
DEFINE
    MEASURE '_Measures'[Net Revenue] =
        SUM ( fact_sales[line_revenue] )

    MEASURE '_Measures'[Gross Revenue] =
        CALCULATE ( SUM ( fact_sales[line_revenue] ), fact_sales[is_return] = FALSE () )

    MEASURE '_Measures'[Returns Value] =
        - CALCULATE ( SUM ( fact_sales[line_revenue] ), fact_sales[is_return] = TRUE () )

    MEASURE '_Measures'[Return Rate %] =
        DIVIDE ( [Returns Value], [Gross Revenue] )

    MEASURE '_Measures'[Orders] =
        CALCULATE ( DISTINCTCOUNT ( fact_sales[invoice] ), fact_sales[is_return] = FALSE () )

    MEASURE '_Measures'[Customers] =
        CALCULATE (
            DISTINCTCOUNT ( fact_sales[customer_id] ),
            fact_sales[is_return] = FALSE (),
            NOT ISBLANK ( fact_sales[customer_id] )
        )

    MEASURE '_Measures'[Avg Order Value] =
        DIVIDE ( [Gross Revenue], [Orders] )

    MEASURE '_Measures'[Units Sold] =
        CALCULATE ( SUM ( fact_sales[quantity] ), fact_sales[is_return] = FALSE () )

    MEASURE '_Measures'[Revenue per Customer] =
        DIVIDE (
            CALCULATE ( [Net Revenue], NOT ISBLANK ( fact_sales[customer_id] ) ),
            [Customers]
        )

    MEASURE '_Measures'[Guest Revenue Share %] =
        DIVIDE ( CALCULATE ( [Gross Revenue], fact_sales[is_guest] = TRUE () ), [Gross Revenue] )

    MEASURE '_Measures'[Repeat Customer Rate %] =
        VAR CustomerOrders =
            ADDCOLUMNS (
                FILTER ( VALUES ( fact_sales[customer_id] ), NOT ISBLANK ( fact_sales[customer_id] ) ),
                "@orders", [Orders]
            )
        RETURN
            DIVIDE (
                COUNTROWS ( FILTER ( CustomerOrders, [@orders] > 1 ) ),
                COUNTROWS ( FILTER ( CustomerOrders, [@orders] >= 1 ) )
            )

    MEASURE '_Measures'[Net Revenue PY] =
        CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )

    MEASURE '_Measures'[Revenue YoY %] =
        DIVIDE ( [Net Revenue] - [Net Revenue PY], [Net Revenue PY] )

    MEASURE '_Measures'[Net Revenue PM] =
        CALCULATE ( [Net Revenue], DATEADD ( dim_date[date], -1, MONTH ) )

    MEASURE '_Measures'[Revenue MoM %] =
        DIVIDE ( [Net Revenue] - [Net Revenue PM], [Net Revenue PM] )

    MEASURE '_Measures'[Net Revenue YTD] =
        TOTALYTD ( [Net Revenue], dim_date[date] )

    MEASURE '_Measures'[Orders PY] =
        CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( dim_date[date] ) )

    MEASURE '_Measures'[Orders YoY %] =
        DIVIDE ( [Orders] - [Orders PY], [Orders PY] )

    MEASURE '_Measures'[Revenue Share of Total %] =
        DIVIDE ( [Net Revenue], CALCULATE ( [Net Revenue], ALLSELECTED ( dim_product ) ) )

    MEASURE '_Measures'[Product Revenue Rank] =
        RANKX ( ALLSELECTED ( dim_product[description] ), [Net Revenue], , DESC, DENSE )

    MEASURE '_Measures'[Champions Revenue] =
        CALCULATE ( [Net Revenue], dim_customer[segment] = "Champions" )

    MEASURE '_Measures'[At Risk Revenue] =
        CALCULATE ( [Net Revenue], dim_customer[segment] = "At Risk" )

    MEASURE '_Measures'[At Risk Customers] =
        CALCULATE ( COUNTROWS ( dim_customer ), dim_customer[segment] = "At Risk" )

    MEASURE '_Measures'[Segment Revenue Share %] =
        DIVIDE ( [Net Revenue], CALCULATE ( [Net Revenue], ALL ( dim_customer[segment] ) ) )

    MEASURE '_Measures'[Actual Revenue (forecast table)] =
        SUM ( fact_forecast[actual] )

    MEASURE '_Measures'[Backtest Prediction] =
        SUM ( fact_forecast[backtest_prediction] )

    MEASURE '_Measures'[Forward Forecast] =
        SUM ( fact_forecast[forward_forecast] )

    MEASURE '_Measures'[Forecast Lower 80] =
        SUM ( fact_forecast[lower_80] )

    MEASURE '_Measures'[Forecast Upper 80] =
        SUM ( fact_forecast[upper_80] )

    MEASURE '_Measures'[Backtest WAPE %] =
        VAR ScoredDays = FILTER ( fact_forecast, NOT ISBLANK ( fact_forecast[backtest_prediction] ) )
        RETURN
            DIVIDE (
                SUMX ( ScoredDays, ABS ( fact_forecast[actual] - fact_forecast[backtest_prediction] ) ),
                SUMX ( ScoredDays, fact_forecast[actual] )
            )

    MEASURE '_Measures'[Flagged Orders] =
        COUNTROWS ( order_anomalies )

    MEASURE '_Measures'[Flagged Orders Cancelled %] =
        DIVIDE ( CALCULATE ( COUNTROWS ( order_anomalies ), order_anomalies[was_cancelled] = TRUE () ), [Flagged Orders] )

EVALUATE
    ROW ( "Net Revenue", [Net Revenue], "Orders", [Orders], "Customers", [Customers] )
